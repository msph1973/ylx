# impeccable-ignore-start
# impeccable (pbakaus/impeccable) — commit .impeccable/config.json (shared detector
# config / source of truth); everything below is per-developer or ephemeral. The CLI
# detector runs via `npx impeccable detect` (downloads on demand), so the vendored
# skill/hook install is not committed. Junie is not a supported provider, so the
# editor-native hook is intentionally skipped.
.impeccable/config.local.json
.impeccable/live/
.impeccable/*.cache.json
.impeccable/hook.cache.json
.github/skills/impeccable/
.github/hooks/impeccable.json
# impeccable-ignore-end
# Added by code-review-graph
.code-review-graph/

# Letta local session pointer (per-machine agent/conversation IDs, not shareable)
.letta/settings.local.json

# Other coding agents' local session-artifact dirs (not meant for this repo,
# no tracked files exist here — see AGENTS.md). Prevents accidental inclusion
# via a broad `git add` when these are sitting untracked in the working tree.
.bob/
.mimocode/
