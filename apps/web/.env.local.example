# Sanity (public - safe for client-side)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Sanity Studio only (packages/sanity) — NOT read by this Astro app; Sanity
# Studio's Vite bundler only exposes env vars prefixed SANITY_STUDIO_ (see
# https://www.sanity.io/docs/studio/environment-variables), so these are
# intentionally separate from PUBLIC_SANITY_PROJECT_ID/DATASET above.
# Required to run `sanity dev`/`sanity deploy` from packages/sanity.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Ably (subscribe-only key for client-side)
PUBLIC_ABLY_KEY=

# --- Server-side only (never exposed to the browser) ---

# Sanity (server-side). SANITY_API_TOKEN is required so reads keep working
# when the dataset is private (see packages/sanity/client.ts). Used for both
# sanityClient (reads) and sanityWriteClient (writes) unless the optional
# read-only token below is set.
SANITY_API_TOKEN=
# Optional: separate read-only token for sanityClient, so reads can actually
# be scoped down from writes instead of sharing one token. Falls back to
# SANITY_API_TOKEN above when unset — safe to leave empty on existing
# deployments.
SANITY_API_READ_TOKEN=

# Ably full key — server-side publish + token minting
ABLY_API_KEY=

# HMAC secret for signing the admin session cookie
SESSION_SECRET=

# Upstash Redis (REST) — required in production; the gallery PIN rate limiter
# fails closed (rejects all PIN attempts) if unset. In local dev it falls back
# to a per-instance in-memory limiter. Get these from the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
