---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  clientName?: string;
  vendorName?: string;
}

const { title, clientName, vendorName } = Astro.props;
// A default parameter only triggers on `undefined` — callers that pass an
// empty string (e.g. before the client name is known) would otherwise
// render a permanently-blank element, so fall back on any falsy value.
const displayClientName = clientName || 'Client';
---

<BaseLayout title={title} vendorName={vendorName}>
  <link slot="head" rel="preconnect" href="https://cdn.sanity.io" />
  <div class="gallery-layout">
    <header class="gallery-header">
      <div class="gallery-brand">{vendorName ?? 'YLx'}</div>
      <div class="gallery-client">
        {/* id targeted by GalleryPage.tsx once the PIN-authenticated client's
            real clientName arrives client-side — this initial render must
            stay privacy-safe (no real name pre-PIN), see displayClientName. */}
        <span id="gallery-client-name">{displayClientName}</span>
      </div>
    </header>
    <main class="gallery-content">
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .gallery-layout {
    min-height: 100vh;
    min-height: 100dvh;
    /* Grid (not flex) so `.gallery-content`'s row size counts as a definite
       height for percentage-height descendants — Chrome/Safari have a known
       flexbug where a flex item's flex-grow-derived height doesn't count as
       "definite" for a further-nested child's percentage height, but a grid
       track does. GalleryPage.tsx's PIN screen relies on this to fill the
       exact space below the header instead of overflowing past 100vh. */
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .gallery-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-6);
    padding-top: max(var(--space-4), env(safe-area-inset-top));
    padding-left: max(var(--space-6), env(safe-area-inset-left));
    padding-right: max(var(--space-6), env(safe-area-inset-right));
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
  }

  .gallery-brand {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }

  .gallery-client {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .gallery-content {
    /* No sizing property needed — the 1fr row in .gallery-layout already
       gives this its height; grid items fill their track by default. */
    padding: var(--space-6);
    padding-left: max(var(--space-6), env(safe-area-inset-left));
    padding-right: max(var(--space-6), env(safe-area-inset-right));
  }

  @media (min-width: 768px) {
    .gallery-content {
      padding: var(--space-8);
      padding-left: max(var(--space-8), env(safe-area-inset-left));
      padding-right: max(var(--space-8), env(safe-area-inset-right));
    }
  }
</style>
