---
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title: string;
  description?: string;
  vendorName?: string;
  /** BCP 47 language of this page's *content* (not the app's default) —
      most pages are English, but a page rendering Bahasa Indonesia copy
      (e.g. the homepage) must declare "id" so assistive tech doesn't read
      it with English pronunciation. */
  lang?: string;
}

const { title, description = 'Photo Proofing Gallery Platform', vendorName, lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- impeccable-disable overused-font, single-font -- Inter is intentionally paired with Playfair Display (both loaded below); the detector only parses the first family, so single-font is a false positive -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} | {vendorName ?? 'YLx'}</title>
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
