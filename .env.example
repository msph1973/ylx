# Sanity (public - safe for client-side)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Sanity (server-side). SANITY_API_TOKEN is required so reads keep working
# when the dataset is private (see packages/sanity/client.ts).
SANITY_API_TOKEN=

# Ably
# Root key for admin operations (server-side publish + token minting)
ABLY_API_KEY=
# Subscribe-only key for client-side realtime
PUBLIC_ABLY_KEY=

# HMAC secret for signing the admin session cookie
SESSION_SECRET=

# Upstash Redis (REST) — optional. Gallery PIN rate limiter persists across
# serverless cold-starts when set; falls back to in-memory otherwise.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
