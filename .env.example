# Sanity (public - safe for client-side)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Sanity (server-side). SANITY_API_TOKEN is required so reads keep working
# when the dataset is private (see packages/sanity/client.ts). Used for both
# sanityClient (reads) and sanityWriteClient (writes) unless the optional
# read-only token below is set.
SANITY_API_TOKEN=
# Optional: separate read-only token for sanityClient, so reads can actually
# be scoped down from writes instead of sharing one token. Falls back to
# SANITY_API_TOKEN above when unset — safe to leave empty on existing
# deployments.
SANITY_API_READ_TOKEN=

# Sanity Studio only (packages/sanity) — NOT read by the Astro app above.
# Sanity Studio's Vite bundler only exposes env vars prefixed SANITY_STUDIO_
# (see https://www.sanity.io/docs/studio/environment-variables), so these are
# intentionally separate from PUBLIC_SANITY_PROJECT_ID/DATASET. Required to
# run `sanity dev`/`sanity deploy` from packages/sanity.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Ably
# Root key for admin operations (server-side publish + token minting)
ABLY_API_KEY=
# Subscribe-only key for client-side realtime
PUBLIC_ABLY_KEY=

# HMAC secret for signing the admin session cookie
SESSION_SECRET=

# Upstash Redis (REST) — required in production. The gallery PIN rate limiter
# fails closed (rejects all PIN attempts) if unset; the in-memory fallback is
# dev-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
